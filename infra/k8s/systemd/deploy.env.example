# Configuration du déploiement continu tiré par le cluster.
# À copier en /etc/qualitos/deploy.env — ce fichier n'est JAMAIS versionné.
#
# Il ne contient aucun identifiant : le dépôt et les images sont publics, et les
# mots de passe d'exploitation (base, realm) sont générés par deploy.sh
# directement dans le cluster, d'où ils ne sortent pas. Si le dépôt devenait
# privé, la clé de lecture se placerait sur ce nœud — toujours pas dans GitHub.

QOS_REPO_URL=https://github.com/Couldevlop/qualitos.git
QOS_BRANCH=main

# Cible du déploiement automatique. `preprod` par défaut : `main` est la branche
# d'intégration, et la production reste une promotion explicite d'une version
# déjà éprouvée. Basculer sur `prod` ici suffirait à automatiser aussi la
# production — c'est un choix d'exploitation, pas une limite technique.
QOS_ENVIRONMENT=preprod

QOS_WORKDIR=/var/lib/qualitos/deploy
QOS_REGISTRY=ghcr.io/couldevlop/qualitos
KUBECONFIG=/etc/rancher/k3s/k3s.yaml
