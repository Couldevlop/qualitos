# Proxy d'entrée du mode léger (ADR 0084) — les MÊMES routes que l'ingress
# Kubernetes (chart qualitos + dépendances), plus TLS. __QOS_HOST__ est remplacé
# à l'installation.
#
# Le résolveur de Docker et des noms en variables : nginx démarre même si un
# service n'est pas encore là, et retrouve le conteneur après un redémarrage
# (son adresse change) au lieu de garder l'ancienne en cache.

resolver 127.0.0.11 valid=10s ipv6=off;

server_tokens off;

map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

# Le seul usage du port 80 : renvoyer vers HTTPS.
server {
  listen 80;
  server_name __QOS_HOST__;
  return 301 https://$host$request_uri;
}

server {
  listen 443 ssl;
  http2 on;
  server_name __QOS_HOST__;

  ssl_certificate     /etc/qualitos/tls/tls.crt;
  ssl_certificate_key /etc/qualitos/tls/tls.key;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers off;
  ssl_session_cache shared:qualitos:10m;

  add_header Strict-Transport-Security "max-age=31536000" always;

  # Pièces jointes déposées (photos de NC, preuves CAPA) : 12 Mo, comme l'ingress.
  client_max_body_size 12m;

  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto https;
  proxy_set_header X-Forwarded-Host $host;
  proxy_set_header X-Forwarded-Port 443;
  proxy_set_header Upgrade $http_upgrade;
  proxy_set_header Connection $connection_upgrade;
  proxy_read_timeout 300s;

  set $keycloak http://keycloak:8080;
  set $core     http://api-core:8081;
  set $engine   http://api-quality-engine:8082;
  set $iot      http://api-iot-hub:8083;
  set $web      http://web:8080;
  set $minio    http://minio:9000;

  location /auth/ { proxy_pass $keycloak; }

  # Socle : comptes, édition et licence, console éditeur (absente en on-premise).
  location /api/v1/tenants { proxy_pass $core; }
  location /api/v1/users   { proxy_pass $core; }
  location /api/v1/edition { proxy_pass $core; }
  location /api/v1/admin   { proxy_pass $core; }
  location /api/v1/iot     { proxy_pass $iot; }
  location /api/           { proxy_pass $engine; }

  # Pièces jointes servies par le stockage objet, par URL présignée. L'en-tête
  # Host d'origine est transmis : la signature le couvre. Lecture seule, et la
  # réponse ne peut ni s'exécuter dans la page (CSP sandbox) ni rester en cache.
  location /qualitos-evidence/ {
    limit_except GET HEAD OPTIONS { deny all; }
    client_max_body_size 1k;
    proxy_pass $minio;
    proxy_hide_header Content-Security-Policy;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Content-Security-Policy "sandbox; default-src 'none'" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Cache-Control "private, no-store" always;
  }

  location / { proxy_pass $web; }
}
