{
  "id": "qualitos",
  "realm": "qualitos",
  "enabled": true,
  "displayName": "QualitOS",
  "loginTheme": "keycloak",
  "registrationAllowed": false,
  "registrationEmailAsUsername": false,
  "rememberMe": true,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "failureFactor": 10,
  "defaultSignatureAlgorithm": "RS256",
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      {
        "name": "super_admin",
        "description": "Plateforme — accès total"
      },
      {
        "name": "admin_tenant",
        "description": "Admin du tenant"
      },
      {
        "name": "quality_director",
        "description": "Directeur Qualité"
      },
      {
        "name": "quality_manager",
        "description": "Manager Qualité"
      },
      {
        "name": "auditor",
        "description": "Auditeur interne"
      },
      {
        "name": "user",
        "description": "Utilisateur standard"
      },
      {
        "name": "external_auditor",
        "description": "Auditeur tiers, accès limité dans le temps"
      }
    ]
  },
  "clients": [
    {
      "clientId": "qualitos-web",
      "name": "QualitOS Web Frontend",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "rootUrl": "http://localhost:4200",
      "baseUrl": "http://localhost:4200/",
      "redirectUris": [
        "http://localhost:4200/*"
      ],
      "webOrigins": [
        "http://localhost:4200",
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4200/*",
        "acr.loa.map": "{\"silver\":1,\"gold\":2}"
      },
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "qualitos-api",
      "name": "QualitOS API (resource server)",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "api-quality-engine-ai",
      "name": "Appels serveur-a-serveur engine -> ai-service",
      "description": "Client confidentiel client_credentials. Le secret n'est PAS ici : il est genere au deploiement et injecte par variable d'environnement (SS18.2-3).",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "attributes": {
        "access.token.lifespan": "300"
      },
      "protocolMappers": [
        {
          "name": "audience-qualitos-ai",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "qualitos-ai",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "qualitos-ai",
      "name": "ai-service (audience)",
      "description": "Client bearer-only : represente l'ai-service comme AUDIENCE des jetons de service.",
      "enabled": true,
      "protocol": "openid-connect",
      "bearerOnly": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": false
    }
  ],
  "users": [
    {
      "username": "superadmin",
      "email": "superadmin@qualitos.local",
      "firstName": "Super",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "${QOS_LOCAL_SUPERADMIN_PASSWORD}",
          "temporary": false
        }
      ],
      "attributes": {
        "tenant_id": [
          "00000000-0000-0000-0000-000000000099"
        ]
      },
      "realmRoles": [
        "super_admin"
      ],
      "requiredActions": [
        "CONFIGURE_TOTP"
      ]
    },
    {
      "username": "admin",
      "email": "admin@qualitos.local",
      "firstName": "Admin",
      "lastName": "Tenant",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "${QOS_LOCAL_ADMIN_PASSWORD}",
          "temporary": false
        }
      ],
      "attributes": {
        "tenant_id": [
          "00000000-0000-0000-0000-000000000099"
        ]
      },
      "realmRoles": [
        "admin_tenant"
      ],
      "requiredActions": [
        "CONFIGURE_TOTP"
      ]
    },
    {
      "username": "demo",
      "email": "demo@qualitos.local",
      "firstName": "Demo",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "demo",
          "temporary": false
        }
      ],
      "attributes": {
        "tenant_id": [
          "00000000-0000-0000-0000-000000000099"
        ]
      },
      "realmRoles": [
        "quality_manager",
        "user"
      ]
    }
  ],
  "authenticationFlows": [
    {
      "alias": "browser-mfa",
      "description": "Connexion navigateur avec second facteur impose aux comptes d'administration (CLAUDE.md SS11.1 A07).",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false,
          "autheticatorFlow": false,
          "authenticator": "auth-cookie"
        },
        {
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false,
          "autheticatorFlow": false,
          "authenticator": "identity-provider-redirector"
        },
        {
          "requirement": "ALTERNATIVE",
          "priority": 30,
          "userSetupAllowed": false,
          "autheticatorFlow": true,
          "flowAlias": "browser-mfa-forms"
        }
      ]
    },
    {
      "alias": "browser-mfa-forms",
      "description": "Identifiants puis second facteur conditionnel.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "CONDITIONAL",
          "priority": 10,
          "userSetupAllowed": false,
          "autheticatorFlow": true,
          "flowAlias": "browser-mfa-loa1"
        },
        {
          "requirement": "CONDITIONAL",
          "priority": 20,
          "userSetupAllowed": false,
          "autheticatorFlow": true,
          "flowAlias": "browser-mfa-otp-superadmin"
        },
        {
          "requirement": "CONDITIONAL",
          "priority": 30,
          "userSetupAllowed": false,
          "autheticatorFlow": true,
          "flowAlias": "browser-mfa-otp-admin"
        },
        {
          "requirement": "CONDITIONAL",
          "priority": 40,
          "userSetupAllowed": false,
          "autheticatorFlow": true,
          "flowAlias": "browser-mfa-otp-loa2"
        }
      ]
    },
    {
      "alias": "browser-mfa-loa1",
      "description": "Mot de passe : palier silver. Le declarer est ce qui empeche Keycloak de traiter toute connexion comme une demande du palier maximal.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "autheticatorFlow": false,
          "authenticator": "conditional-level-of-authentication",
          "authenticatorConfig": "cfg-browser-mfa-loa1"
        },
        {
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false,
          "autheticatorFlow": false,
          "authenticator": "auth-username-password-form"
        }
      ]
    },
    {
      "alias": "browser-mfa-otp-superadmin",
      "description": "OTP obligatoire pour le role super_admin",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "autheticatorFlow": false,
          "authenticator": "conditional-user-role",
          "authenticatorConfig": "cfg-browser-mfa-otp-superadmin"
        },
        {
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false,
          "autheticatorFlow": false,
          "authenticator": "auth-otp-form"
        }
      ]
    },
    {
      "alias": "browser-mfa-otp-admin",
      "description": "OTP obligatoire pour le role admin_tenant",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "autheticatorFlow": false,
          "authenticator": "conditional-user-role",
          "authenticatorConfig": "cfg-browser-mfa-otp-admin"
        },
        {
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false,
          "autheticatorFlow": false,
          "authenticator": "auth-otp-form"
        }
      ]
    },
    {
      "alias": "browser-mfa-otp-loa2",
      "description": "Code a usage unique exige quand le client demande le palier gold",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "autheticatorFlow": false,
          "authenticator": "conditional-level-of-authentication",
          "authenticatorConfig": "cfg-browser-mfa-loa2"
        },
        {
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false,
          "autheticatorFlow": false,
          "authenticator": "auth-otp-form"
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "cfg-browser-mfa-otp-superadmin",
      "config": {
        "condUserRole": "super_admin"
      }
    },
    {
      "alias": "cfg-browser-mfa-otp-admin",
      "config": {
        "condUserRole": "admin_tenant"
      }
    },
    {
      "alias": "cfg-browser-mfa-loa2",
      "config": {
        "loa-condition-level": "2",
        "loa-max-age": "3600"
      }
    },
    {
      "alias": "cfg-browser-mfa-loa1",
      "config": {
        "loa-condition-level": "1",
        "loa-max-age": "3600"
      }
    }
  ],
  "browserFlow": "browser-mfa",
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpPolicyLookAheadWindow": 1,
  "otpPolicyCodeReusable": false,
  "otpSupportedApplications": [
    "totpAppFreeOTPName",
    "totpAppGoogleName",
    "totpAppMicrosoftAuthenticatorName"
  ],
  "requiredActions": [
    {
      "alias": "CONFIGURE_TOTP",
      "name": "Configure OTP",
      "providerId": "CONFIGURE_TOTP",
      "enabled": true,
      "defaultAction": false,
      "priority": 10,
      "config": {}
    },
    {
      "alias": "UPDATE_PASSWORD",
      "name": "Update Password",
      "providerId": "UPDATE_PASSWORD",
      "enabled": true,
      "defaultAction": false,
      "priority": 30,
      "config": {}
    }
  ],
  "attributes": {
    "acr.loa.map": "{\"silver\":1,\"gold\":2}"
  }
}
