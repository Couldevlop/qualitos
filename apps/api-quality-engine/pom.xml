<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.openlab.qualitos</groupId>
        <artifactId>qualitos-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>api-quality-engine</artifactId>
    <name>QualitOS Quality Engine</name>
    <description>Quality Engine — PDCA, 5S, Ishikawa, DMAIC, Cercle de Qualité</description>

    <dependencyManagement>
        <dependencies>
            <!-- BOM AWS SDK v2 : aligne s3 + ses transitives (smithy, http-client).
                 Version explicite (le parent qualitos n'embarque pas le BOM AWS). -->
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>2.31.78</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- Courriel de rappel d'échéance d'audit (CLAUDE.md §4.4).
             INERTE par défaut : l'adaptateur SmtpAuditReminderMailer est conditionné à
             qualitos.mail.enabled=true, et sans lui personne n'envoie rien. Le
             JavaMailSender auto-configuré, lui, EST créé (la condition porte sur la
             présence de spring.mail.host, pas sur sa valeur) : il reste inutilisé, et
             son indicateur de santé est éteint avec la brique — voir application.yml,
             où le piège est décrit. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>
        <!-- Socle Kafka (CLAUDE.md §10.1) : producteur du relais outbox audit_events.
             INERTE par défaut (relais gated par qualitos.kafka.enabled=false) — le
             KafkaTemplate auto-configuré est paresseux et ne se connecte que si utilisé. -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- Observabilité (§14, §20) : métriques Prometheus exposées sur
             /actuator/prometheus + logs JSON structurés (logstash encoder, profil
             hors-dev via logback-spring.xml). Scrapées par le profil compose
             'observability' (Prometheus + Grafana) et par K8s en prod. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
            <version>8.1</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- Crypto-agility + signatures hybrides ML-DSA (ADR 0011). -->
        <dependency>
            <groupId>com.openlab.qualitos</groupId>
            <artifactId>security-commons-crypto</artifactId>
            <version>0.1.0-SNAPSHOT</version>
        </dependency>

        <!-- Génération PDF des exports de dashboard signés (§7.3/§7.4, ADR 0043).
             Apache PDFBox 3.0.x : moteur PDF pur-Java, mature, pas de CVE
             Haute/Critique connue (§18.2 #1). ZXing core : génération du QR code
             de vérification incrusté dans le PDF. -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>3.0.5</version>
        </dependency>
        <!-- Extraction Excel du PFMEA et du plan de surveillance d'un produit.
             Un VRAI classeur, et non un CSV renomme : les deux tableaux ne
             tiennent pas dans un seul onglet, et le plan de surveillance
             compte a lui seul une vingtaine de colonnes. poi-ooxml est le seul
             moyen pur-Java d'ecrire du .xlsx multi-feuilles.
             `poi-ooxml-lite` plutot que le schema complet : il porte les seuls
             modeles XML dont SXSSF a besoin, pour ~10 Mo au lieu de ~15. -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.4.1</version>
            <exclusions>
                <exclusion>
                    <groupId>org.apache.poi</groupId>
                    <artifactId>poi-ooxml-full</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml-lite</artifactId>
            <version>5.4.1</version>
        </dependency>

        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>core</artifactId>
            <version>3.5.3</version>
        </dependency>

        <!-- Stockage binaire S3-compatible (MinIO) des photos de NC (§4.3).
             Adaptateur activé uniquement sous qualitos.storage.s3.enabled=true ;
             sans config le client S3 n'est jamais instancié. Version gérée par le
             BOM AWS (dependencyManagement ci-dessous). -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>1.3.0</version>
            <scope>test</scope>
        </dependency>
        <!-- H2 en mode PostgreSQL suffit au comportement applicatif, mais il ignore
             les index partiels et les contraintes d'exclusion. Les migrations qui
             en posent ne se vérifient donc que sur un vrai serveur : Testcontainers
             en démarre un le temps du test, et le test se saute proprement là où
             Docker n'est pas disponible. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>21</source>
                    <target>21</target>
                    <parameters>true</parameters>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
