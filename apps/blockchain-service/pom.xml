<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      Module AUTONOME (volontairement HORS du réacteur qualitos) : il porte les
      dépendances lourdes Hyperledger Fabric (gRPC/protobuf/MSP) qui ne doivent pas
      alourdir l'engine ni casser `mvn verify` du réacteur si elles ne résolvent pas.
      Se construit indépendamment : `mvn -f apps/blockchain-service/pom.xml package`.
      Cf. ADR 0012 Phase B.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!-- 3.5.0 embarquait un contournement d'authentification Actuator
             (CVE-2026-22733) et CVE-2026-22731, corrigés en 3.5.12. Ce module
             ayant son PROPRE parent, il ne bénéficie d'aucune des surcharges de
             sécurité de qualitos-parent : ses versions doivent être suivies ici,
             séparément. -->
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.openlab.qualitos</groupId>
    <artifactId>blockchain-service</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>QualitOS Blockchain Service</name>
    <description>Passerelle Hyperledger Fabric (ancrage des Merkle roots d'audit) — ADR 0012 Phase B</description>

    <properties>
        <java.version>21</java.version>
        <fabric-gateway.version>1.7.1</fabric-gateway.version>
        <!-- Aligné par le BOM (voir dependencyManagement). 1.65.1 traînait
             CVE-2025-55163 (déni de service HTTP/2 dans le netty embarqué) et
             était de surcroît PLUS ANCIEN que le grpc-bom 1.69.0 importé par
             fabric-gateway 1.7.1 : on épinglait donc à la baisse un transport
             que le SDK attendait plus récent. -->
        <grpc.version>1.83.1</grpc.version>
        <!-- fabric-gateway 1.7.1 / fabric-protos 0.3.4 sont générés avec protobuf 4.x
             (classe com.google.protobuf.RuntimeVersion). Spring Boot 3.5 gère protobuf-java
             en 3.25.x → NoClassDefFoundError au démarrage. On force la 4.28.x (compatible
             grpc 1.65.1). -->
        <protobuf-java.version>4.28.3</protobuf-java.version>
        <!-- fabric-gateway tire Bouncy Castle 1.79, porteur de CVE-2025-14813
             (CRITICAL). Le pom racine impose déjà 1.84, mais ce module a son
             PROPRE parent et n'hérite d'aucune de ses surcharges : la version
             doit donc être répétée ici. C'est exactement le coût de l'autonomie
             revendiquée par ce module, et la raison pour laquelle ses versions
             doivent être suivies séparément. -->
        <bouncycastle.version>1.84</bouncycastle.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- protobuf 4.x explicite : fabric-protos 0.3.4 référence com.google.protobuf.
             RuntimeVersion (absent en 3.25.x géré par Spring Boot). La version explicite
             prime sur le dependencyManagement. -->
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
            <version>4.28.3</version>
        </dependency>

        <!-- Fabric Gateway SDK (client API Fabric 2.4+) -->
        <dependency>
            <groupId>org.hyperledger.fabric</groupId>
            <artifactId>fabric-gateway</artifactId>
            <version>${fabric-gateway.version}</version>
        </dependency>
        <!-- Transport gRPC vers le peer (TLS). Pas de version ici : elle vient
             du grpc-bom ci-dessous, pour que TOUS les artefacts gRPC (api, core,
             protobuf, netty-shaded) restent sur la même version. Les mélanger est
             la cause classique de NoSuchMethodError au premier appel. -->
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-netty-shaded</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <dependencyManagement>
        <dependencies>
            <!-- Importé APRÈS les dépendances pour primer sur le grpc-bom 1.69.0
                 que fabric-gateway importe transitivement. -->
            <!-- Bouncy Castle aligné : bcpkix et bcutil arrivent aussi en
                 transitif, les laisser diverger de bcprov provoque des erreurs
                 de chargement de provider à l'exécution. -->
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcprov-jdk18on</artifactId>
                <version>${bouncycastle.version}</version>
            </dependency>
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcpkix-jdk18on</artifactId>
                <version>${bouncycastle.version}</version>
            </dependency>
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcutil-jdk18on</artifactId>
                <version>${bouncycastle.version}</version>
            </dependency>
            <dependency>
                <groupId>io.grpc</groupId>
                <artifactId>grpc-bom</artifactId>
                <version>${grpc.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
