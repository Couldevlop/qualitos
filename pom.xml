<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!-- Spring Boot 4 (Spring Framework 7) : seule sortie des CVE-2026-47884 et
             CVE-2026-47890 de spring-webmvc, corrigées en 7.0.9 et jamais sur la
             ligne 6.2 (ADR 0100). Ligne 4.1 depuis 4.1.2 : suivre son dernier
             patch (règle §18.2.1 : 0 CVE Critique/Haute). -->
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>com.openlab.qualitos</groupId>
    <artifactId>qualitos-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>QualitOS Parent</name>
    <description>Quality Operating System — Multi-tenant SaaS QMS Platform</description>

    <modules>
        <module>libs/industry-commons</module>
        <module>libs/security-commons-crypto</module>
        <!-- Édition et licence on-premise (ADR 0082) : vérifiée hors ligne. -->
        <module>libs/licensing</module>
        <!-- JAR Keycloak SPI (déployé dans /opt/keycloak/providers/) — module sœur,
             jamais une dépendance des services Spring. Validé par le réacteur
             (placeholder COPY requis dans les Dockerfiles core/engine/iot). -->
        <module>libs/keycloak-spi-ldap</module>
        <module>apps/api-core</module>
        <module>apps/api-quality-engine</module>
        <module>apps/api-iot-hub</module>
        <module>apps/blockchain-service</module>
        <!-- api-connectors lives on feature/p4-foundations until merged. -->
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!-- Aucune surcharge de version gérée par Spring Boot : Boot 4.1.2 gère
             tomcat 11.0.27, netty 4.2.19, jackson 2.21.7 (jackson-2-bom) et pgjdbc
             42.7.14, au-delà des correctifs que les surcharges de la ligne 3.5
             allaient chercher (ADR 0100). En rajouter une seulement si Boot prend
             du retard, avec la CVE et la date de retrait. -->
        <!-- Dependency versions -->
        <mapstruct.version>1.6.3</mapstruct.version>
        <jjwt.version>0.12.6</jjwt.version>
        <!-- springdoc 3.x : la ligne compatible Spring Boot 4 ; 3.2.0 est construite
             sur Boot 4.1.2. -->
        <springdoc.version>3.2.0</springdoc.version>
        <!-- Bouncy Castle : fournit ML-DSA (FIPS 204) + ML-KEM (FIPS 203). cf. ADR 0011.
             bcprov-jdk18on n'est PAS FIPS-validé → marqué dev dans le CBOM ; la prod
             régulée bascule sur bc-fips via le même SPI (crypto-agility).
             ≥ 1.81 requis pour bctls : 1re version qui enregistre le groupe
             hybride standardisé X25519MLKEM768 (RFC 9794, codepoint 0x11EC) dans le
             provider BCJSSE — cf. §11.4 « TLS hybride X25519 + ML-KEM-768 ». Les
             versions 1.79/1.80 n'exposent que des ML-KEM purs (pas d'hybride X25519).
             1.84 : corrige CVE-2026-5598 (fuite de clé privée via comparaisons non
             constant-time) — critique pour nos signatures ML-DSA.
             1.86 : corrige CVE-2026-8763 (CRITICAL) et CVE-2026-13506 (HIGH, déni
             de service), publiées sur 1.84 et bloquantes au scan SCA. -->
        <bouncycastle.version>1.86</bouncycastle.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- CVE-2026-106451 (exécution de code, HIGH) : lz4-java 1.10.1, tiré
                 transitivement (kafka-clients), corrigé en 1.11.4. -->
            <dependency>
                <groupId>at.yawk.lz4</groupId>
                <artifactId>lz4-java</artifactId>
                <version>1.11.4</version>
            </dependency>
            <!-- CVE-2026-108106 et CVE-2026-93451 (déni de service, dépassement de
                 tampon, HIGH) : snappy-java 1.1.10.7, tiré transitivement
                 (kafka-clients), corrigé en 1.1.10.9. -->
            <dependency>
                <groupId>org.xerial.snappy</groupId>
                <artifactId>snappy-java</artifactId>
                <version>1.1.10.9</version>
            </dependency>
            <!-- CVE-2026-102554 (déni de service, HIGH) : guava 33.2.1-jre, tiré
                 transitivement, corrigé en 33.7.2. -->
            <dependency>
                <groupId>com.google.guava</groupId>
                <artifactId>guava</artifactId>
                <version>33.7.2-jre</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt.version}</version>
                <scope>runtime</scope>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jjwt.version}</version>
                <scope>runtime</scope>
            </dependency>
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcprov-jdk18on</artifactId>
                <version>${bouncycastle.version}</version>
            </dependency>
            <!-- bctls : provider BCJSSE pour le TLS hybride post-quantique (§11.4).
                 Apporte le groupe nommé X25519MLKEM768. Optionnel à l'exécution :
                 activé uniquement sous le profil Spring "tls" de api-core. -->
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bctls-jdk18on</artifactId>
                <version>${bouncycastle.version}</version>
            </dependency>
            <!-- bcpkix : génération de certificats X.509 (self-signed en test, CSR/PKI). -->
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcpkix-jdk18on</artifactId>
                <version>${bouncycastle.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <source>21</source>
                        <target>21</target>
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <useModulePath>false</useModulePath>
                        <!-- Parallélisation JUnit 5 *dans* le même fork.
                             Évite les conflits multi-forks avec l'agent JaCoCo
                             (qui écrit dans target/jacoco.exec) tout en
                             réduisant le temps wall-clock des tests purement
                             unitaires (domain/application). Les WebMvcTest
                             (Spring) restent isolés via @Execution(SAME_THREAD)
                             par défaut sous JUnit. -->
                        <properties>
                            <configurationParameters>
                                junit.jupiter.execution.parallel.enabled=true
                                junit.jupiter.execution.parallel.mode.default=same_thread
                                junit.jupiter.execution.parallel.mode.classes.default=concurrent
                                junit.jupiter.execution.parallel.config.strategy=dynamic
                            </configurationParameters>
                        </properties>
                    </configuration>
                </plugin>
                <!-- Javadoc : la référence de classes de `docs/PASSATION.md` §5.
                     Aucune exécution n'est liée à une phase — le but n'est pas
                     d'alourdir `verify`, mais que `mvn javadoc:javadoc` marche
                     sans qu'on ait à retrouver les bons drapeaux.

                     `doclint` est DÉSACTIVÉ, et c'est délibéré : le code est
                     commenté en français, densément, pour dire le POURQUOI —
                     pas pour satisfaire un vérificateur de balises. Avec
                     doclint actif, un `@param` manquant sur une méthode privée
                     fait échouer la génération entière, et on perd 5 000 pages
                     utiles pour une balise absente. Si l'on veut un jour tenir
                     les balises, ce sera une décision séparée, avec l'effort de
                     reprise qui va avec. -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <configuration>
                        <doclint>none</doclint>
                        <encoding>UTF-8</encoding>
                        <docencoding>UTF-8</docencoding>
                        <charset>UTF-8</charset>
                        <locale>fr</locale>
                        <!-- Les tests ne sont pas une surface à documenter. -->
                        <includeDependencySources>false</includeDependencySources>
                        <quiet>true</quiet>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>0.8.12</version>
                    <executions>
                        <execution>
                            <goals>
                                <goal>prepare-agent</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>report</id>
                            <phase>test</phase>
                            <goals>
                                <goal>report</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>check</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>check</goal>
                            </goals>
                            <configuration>
                                <!-- Exclure les classes de configuration Spring et les entités
                                     du calcul de couverture — elles sont couvertes indirectement
                                     par les tests d'intégration, pas par les tests unitaires.
                                     Les connecteurs d'ingestion réseau (OPC-UA Milo, MQTT Paho)
                                     et leur câblage Spring exigent un serveur/broker live :
                                     testés en intégration (gating off par défaut), pas en unitaire. -->
                                <excludes>
                                    <exclude>**/config/**</exclude>
                                    <exclude>**/*Application.class</exclude>
                                    <exclude>**/*Entity.class</exclude>
                                    <exclude>**/*IngestionConnector.class</exclude>
                                    <exclude>**/*ConnectorConfig.class</exclude>
                                </excludes>
                                <rules>
                                    <rule>
                                        <element>BUNDLE</element>
                                        <limits>
                                            <limit>
                                                <counter>LINE</counter>
                                                <value>COVEREDRATIO</value>
                                                <minimum>0.85</minimum>
                                            </limit>
                                            <limit>
                                                <counter>BRANCH</counter>
                                                <value>COVEREDRATIO</value>
                                                <minimum>0.75</minimum>
                                            </limit>
                                        </limits>
                                    </rule>
                                </rules>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <!-- Profil dev : boucle d'itération rapide.
             - Skip JaCoCo (rapport + check) → -2 phases
             - Exclut les WebMvcTest taggés "web" (Spring context = ~6-8s/classe)
             - Reste : domain + application + infrastructure mapper/publisher
             Usage typique :
                mvn -P dev test                                     (~10-15s total)
                mvn -P dev -Dtest='com.…<module>.**' test          (~3-5s ciblé)
             Le verify complet (suite + JaCoCo) reste obligatoire avant push. -->
        <profile>
            <id>dev</id>
            <properties>
                <jacoco.skip>true</jacoco.skip>
            </properties>
            <build>
                <pluginManagement>
                    <plugins>
                        <plugin>
                            <groupId>org.apache.maven.plugins</groupId>
                            <artifactId>maven-surefire-plugin</artifactId>
                            <configuration>
                                <excludedGroups>web</excludedGroups>
                            </configuration>
                        </plugin>
                    </plugins>
                </pluginManagement>
            </build>
        </profile>
    </profiles>
</project>
