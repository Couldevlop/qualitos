# Maven
target/
.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr
out/
!**/src/main/**/out/
!**/src/test/**/out/

# VS Code
.vscode/
*.code-workspace

# Eclipse
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

# NetBeans
nbproject/private/
nbbuild/
dist/
nbdist/
.nb-gradle/

# Secrets — NEVER commit
*.env
.env
.env.local
.env.*.local
application-local.yml
application-prod.yml
secrets/
*.pem
*.key
*.p12
*.jks

# Logs
logs/
*.log
*.log.*

# OS
.DS_Store
Thumbs.db

# Node (frontend)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.angular/
apps/web/dist/
apps/web/coverage/

# Nx (future monorepo)
.nx/cache

# Test reports
**/surefire-reports/
**/failsafe-reports/
**/jacoco.exec
**/jacoco/

# DAST OWASP ZAP — rapports générés en local (cf. docs/runbooks/dast-owasp-zap.md)
zap-baseline-report.*
zap-api-scan-report.*
dast-stack.log

# Build output
**/build/

# Python (P5 ai-service)
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
.venv/
venv/

# Claude Code local settings
.claude/settings.local.json
.claude/projects/

# Temp debug files (CI API queries, build/karma logs)
/*.json
!/package.json
ci-remote.yml
install.log
karma.log

# JVM / shell crash dumps (générés lors d'un OOM build)
*.stackdump
hs_err_pid*.log
replay_pid*.log
karma.zip

# Identifiants locaux de dev — NE JAMAIS committer
.credentials-local.md

# Binaire compilé du chaincode Go : produit par `go build` dans le répertoire du
# module, jamais un artefact de source.
/infra/blockchain/chaincode/*/qualitos-anchor

# Espace de travail des specs de l’assistant — pas un artefact du dépôt.
# Les décisions qui comptent vivent dans docs/adr/.
docs/superpowers/

# Fichiers de verrouillage Office (Excel/Word ouverts) — jamais versionnés.
~$*

# Artefacts du plugin Semgrep Guardian (outil de poste, pas un livrable).
.semgrep/

# Bac à sable de poste (journaux de test, sorties de CI rejouées en local).
tmp/

# Cles PRIVEES de l editeur (licences on-premise, ADR 0082) : jamais dans le depot.
*cles-privees*.properties
*private-keys*.properties
*.lic

# Documents de travail deposes dans docs/ (etudes, maquettes, recettes, captures,
# classeurs) : ils circulent par courriel ou par le partage de fichiers, et le
# depot ne les suit pas. Ce qui doit etre versionne s'ecrit en Markdown, et les
# decisions dans docs/adr/. Les livrables de recette tombent sous la meme regle
# pour une raison de plus : scripts/recette/construire.py les regenere, et le
# classeur est rempli a la main pendant la campagne — versionner un binaire
# qu'on edite chaque jour n'apporte que des conflits.
docs/**/*.docx
docs/**/*.xlsx
docs/**/*.pptx
docs/**/*.potx
docs/**/*.pdf
docs/**/*.html
docs/**/*.png
docs/**/*.PNG
docs/**/*.jpg
docs/**/*.jpeg
docs/**/*.svg
